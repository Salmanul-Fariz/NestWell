# Copy this file to .env and replace every placeholder before deploying.
NODE_ENV=production
PORT=3000
# Atlas: use the driver connection string. Do not add replicaSet or directConnection.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/nestwell?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379
JWT_SECRET=<generate-a-long-random-access-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-refresh-secret>
# JWT duration syntax: 15m, 1h, 7d, or 2w. Cookie expiry follows these values.
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
# Optional global fallback for users who have not saved their own CallMeBot key.
# Leave empty to require every WhatsApp-notification user to provide their own key.
CALLMEBOT_API_KEY=
WEB_PUSH_VAPID_PUBLIC=<vapid-public-key>
WEB_PUSH_VAPID_PRIVATE=<vapid-private-key>
WEB_PUSH_CONTACT=mailto:salmanulfariz.dev@gmail.com
COOKIE_SECURE=true
CORS_ORIGIN=https://43.204.217.252
